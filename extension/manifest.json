{
  "manifest_version": 3,
  "name": "学习通题目明文",
  "version": "1.0.2",
  "description": "解出章节测验的混淆题干，还原为明文；按题库或模型自动作答并提交，含空卷拦截。",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.chaoxing.com/*"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "src/nav.js",
        "src/video.js",
        "src/decoder.js",
        "src/extract.js",
        "src/overlay.js",
        "src/answer.js",
        "src/content.js"
      ],
      "css": [
        "src/overlay.css"
      ],
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/ref-subset.woff2"
      ],
      "matches": [
        "https://*.chaoxing.com/*"
      ]
    }
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ]
}